# RT-N10 B1: switch port 0 = WAN (VLAN 2), ports 1-4 = LAN (VLAN 1).
# The switch CPU port is tagged, so eth0 carries both VLANs.

auto lo
iface lo inet loopback

# LAN bridge: eth0.1 + wlan0 (hostapd adds wlan0 with bridge=br0)
auto br0
iface br0 inet static
	address 192.168.10.1
	netmask 255.255.255.0
	pre-up ip link set eth0 up
	pre-up ip link add link eth0 name eth0.1 type vlan id 1
	pre-up ip link set eth0.1 up
	pre-up brctl addbr br0
	pre-up brctl addif br0 eth0.1
	post-down brctl delbr br0
	post-down ip link del eth0.1

# WAN: brought up only, no DHCP client yet
auto eth0.2
iface eth0.2 inet manual
	pre-up ip link add link eth0 name eth0.2 type vlan id 2
	up ip link set eth0.2 up
	post-down ip link del eth0.2

+++ b/drivers/net/ethernet/ralink/Kconfig
@@ -0,0 +1,20 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config NET_VENDOR_RALINK
+	bool "Ralink devices"
+	depends on RALINK || COMPILE_TEST
+	default y
+	help
+	  If you have a Ralink SoC with ethernet, say Y.
+
+if NET_VENDOR_RALINK
+
+config NET_RALINK_RT3050
+	tristate "Ralink RT3050/RT3052/RT3350 ethernet and switch"
+	depends on SOC_RT305X || COMPILE_TEST
+	depends on HAS_DMA && OF
+	select RESET_CONTROLLER
+	help
+	  Driver for the frame engine and the embedded 5 port switch of
+	  the Ralink RT3050, RT3052 and RT3350 SoCs.
+
+endif # NET_VENDOR_RALINK

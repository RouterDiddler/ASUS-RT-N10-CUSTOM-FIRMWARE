diff --git a/drivers/net/ethernet/ralink/rt3050_eth.c b/drivers/net/ethernet/ralink/rt3050_eth.c
new file mode 100644
index 000000000..56a478f1a
--- /dev/null
+++ b/drivers/net/ethernet/ralink/rt3050_eth.c
@@ -0,0 +1,909 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Ralink RT3050 / RT3052 / RT3350 frame engine and embedded switch driver.
+ *
+ * A small driver for the PDMA based frame engine (FE) and the 5+1 port
+ * embedded switch (ESW) of the RT305x WiSoC family. It exposes a single
+ * net_device connected to the switch CPU port.
+ *
+ * Register layout, frame engine forwarding setup and switch initialisation
+ * are derived from the OpenWrt ramips "ralink" ethernet driver
+ * (mtk_eth_soc.c, soc_rt3050.c, esw_rt3050.c):
+ *   Copyright (C) 2009-2015 John Crispin <blogic@openwrt.org>
+ *   Copyright (C) 2009-2015 Felix Fietkau <nbd@nbd.name>
+ *   Copyright (C) 2013-2015 Michael Lee <igvtee@gmail.com>
+ *   Copyright (C) 2016 Vittorio Gambaletta <openwrt@vittgam.net>
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/etherdevice.h>
+#include <linux/if_vlan.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/jiffies.h>
+#include <linux/mii.h>
+#include <linux/module.h>
+#include <linux/netdevice.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_net.h>
+#include <linux/platform_device.h>
+#include <linux/reset.h>
+#include <linux/slab.h>
+
+#define DRV_NAME		"rt3050-eth"
+
+/* ---- frame engine registers ---- */
+#define FE_GLO_CFG		0x008
+#define FE_INT_STATUS		0x010
+#define FE_INT_ENABLE		0x014
+#define FE_GDMA1_FWD_CFG	0x020
+#define FE_GDMA1_MAC_ADRL	0x02c
+#define FE_GDMA1_MAC_ADRH	0x030
+#define FE_PSE_FQ_CFG		0x040
+#define FE_CDMA_CSG_CFG		0x080
+#define FE_PDMA_GLO_CFG		0x100
+#define FE_PDMA_RST_CFG		0x104
+#define FE_DLY_INT_CFG		0x10c
+#define FE_TX_BASE_PTR0		0x110
+#define FE_TX_MAX_CNT0		0x114
+#define FE_TX_CTX_IDX0		0x118
+#define FE_TX_DTX_IDX0		0x11c
+#define FE_RX_BASE_PTR0		0x130
+#define FE_RX_MAX_CNT0		0x134
+#define FE_RX_CALC_IDX0		0x138
+#define FE_RX_DRX_IDX0		0x13c
+
+#define FE_INT_RX_DONE		BIT(2)
+#define FE_INT_TX_DONE		GENMASK(11, 8)
+#define FE_INT_MASK		(FE_INT_RX_DONE | FE_INT_TX_DONE)
+
+#define FE_US_CYC_CNT_MASK	0xff
+#define FE_US_CYC_CNT_SHIFT	8
+
+#define FE_GDM1_ICS_EN		BIT(22)
+#define FE_GDM1_TCS_EN		BIT(21)
+#define FE_GDM1_UCS_EN		BIT(20)
+#define FE_GDM1_JMB_EN		BIT(19)
+#define FE_CSG_ICS_GEN_EN	BIT(2)
+#define FE_CSG_UCS_GEN_EN	BIT(1)
+#define FE_CSG_TCS_GEN_EN	BIT(0)
+#define FE_PSE_FQFC_CFG_INIT	0x80504000
+
+#define PDMA_TX_WB_DDONE	BIT(6)
+#define PDMA_SIZE_8DWORDS	(1 << 4)
+#define PDMA_RX_DMA_BUSY	BIT(3)
+#define PDMA_RX_DMA_EN		BIT(2)
+#define PDMA_TX_DMA_BUSY	BIT(1)
+#define PDMA_TX_DMA_EN		BIT(0)
+#define PDMA_PST_DRX_IDX0	BIT(16)
+#define PDMA_PST_DTX_IDX0	BIT(0)
+
+/* ---- DMA descriptors ---- */
+struct fe_dma_desc {
+	u32 d1;
+	u32 d2;
+	u32 d3;
+	u32 d4;
+};
+
+#define RX_DMA_DONE		BIT(31)
+#define RX_DMA_LSO		BIT(30)
+#define RX_DMA_GET_PLEN0(x)	(((x) >> 16) & 0x3fff)
+
+#define TX_DMA_DONE		BIT(31)
+#define TX_DMA_LS0		BIT(30)
+#define TX_DMA_PLEN0(x)		(((x) & 0x3fff) << 16)
+#define TX_DMA_QN(x)		((x) << 16)
+#define TX_DMA_PN(x)		((x) << 24)
+#define TX_DMA_DESP2_DEF	(TX_DMA_LS0 | TX_DMA_DONE)
+#define TX_DMA_DESP4_DEF	(TX_DMA_QN(3) | TX_DMA_PN(1))
+
+#define FE_NUM_RX		64
+#define FE_NUM_TX		64
+#define FE_RX_BUF_SIZE		1536
+#define FE_TX_MIN_LEN		VLAN_ETH_ZLEN	/* padding bug, see OpenWrt */
+
+/* ---- embedded switch registers ---- */
+#define ESW_REG_ISR		0x00
+#define ESW_REG_IMR		0x04
+#define ESW_REG_FCT0		0x08
+#define ESW_REG_PFC1		0x14
+#define ESW_REG_PVIDC(n)	(0x40 + 4 * (n))
+#define ESW_REG_VLANI(n)	(0x50 + 4 * (n))
+#define ESW_REG_VMSC(n)		(0x70 + 4 * (n))
+#define ESW_REG_POA		0x80
+#define ESW_REG_FPA		0x84
+#define ESW_REG_SOCPC		0x8c
+#define ESW_REG_POC0		0x90
+#define ESW_REG_POC2		0x98
+#define ESW_REG_SGC		0x9c
+#define ESW_REG_P0LED		0xa4
+#define ESW_REG_PCR0		0xc0
+#define ESW_REG_PCR1		0xc4
+#define ESW_REG_FPA2		0xc8
+#define ESW_REG_FCT2		0xcc
+#define ESW_REG_SGC2		0xe4
+
+#define ESW_PCR0_WT_NWAY_DATA_S	16
+#define ESW_PCR0_WT_PHY_CMD	BIT(13)
+#define ESW_PCR0_CPU_PHY_REG_S	8
+#define ESW_PCR1_WT_DONE	BIT(0)
+
+#define ESW_PVIDC_PVID_M	0xfff
+#define ESW_PVIDC_PVID_S	12
+#define ESW_VLANI_VID_M		0xfff
+#define ESW_VLANI_VID_S		12
+#define ESW_VMSC_MSC_M		0xff
+#define ESW_VMSC_MSC_S		8
+#define ESW_SOCPC_DISUN2CPU_S	0
+#define ESW_SOCPC_DISMC2CPU_S	8
+#define ESW_SOCPC_DISBC2CPU_S	16
+#define ESW_SOCPC_CRC_PADDING	BIT(25)
+#define ESW_POC0_EN_BP_S	0
+#define ESW_POC0_EN_FC_S	8
+#define ESW_POC0_DIS_PORT_M	0x7f
+#define ESW_POC0_DIS_PORT_S	23
+#define ESW_POC2_UNTAG_EN_M	0xff
+#define ESW_POC2_UNTAG_EN_S	0
+#define ESW_POC2_ENAGING_S	8
+#define ESW_SGC2_DOUBLE_TAG_M	0x7f
+#define ESW_SGC2_DOUBLE_TAG_S	0
+#define ESW_SGC2_LAN_PMAP_M	0x3f
+#define ESW_SGC2_LAN_PMAP_S	24
+#define ESW_PFC1_EN_VLAN_M	0xff
+#define ESW_PFC1_EN_VLAN_S	16
+#define ESW_POA_LINK_S		25
+#define ESW_POA_LINK_M		0x1f
+#define ESW_PORT_ST_CHG		BIT(26)
+
+#define ESW_VLAN_NONE		0xfff
+#define ESW_NUM_VLANS		16
+#define ESW_NUM_PORTS		7
+#define ESW_NUM_PHYS		5
+#define ESW_PORT_CPU		6
+#define ESW_PORTS_INTERNAL	GENMASK(4, 0)
+#define ESW_PORTS_NOCPU		GENMASK(5, 0)
+#define ESW_PORTS_CPU		BIT(ESW_PORT_CPU)
+#define ESW_PORTS_ALL		GENMASK(6, 0)
+#define ESW_PMAP_LLLLLL		0x3f
+#define ESW_PHY_TIMEOUT		(5 * HZ)
+
+struct fe_priv {
+	struct net_device	*netdev;
+	struct device		*dev;
+	void __iomem		*base;
+	void __iomem		*esw;
+	struct napi_struct	napi;
+	struct reset_control	*rst_fe;
+	unsigned long		sysclk;
+	int			irq;
+	int			wan_port;	/* -1: flat switch, no VLANs */
+	u32			port_disable;
+
+	struct fe_dma_desc	*rx_ring;
+	dma_addr_t		rx_phys;
+	void			*rx_buf[FE_NUM_RX];
+	dma_addr_t		rx_dma[FE_NUM_RX];
+	unsigned int		rx_idx;		/* last index given back to hw */
+
+	struct fe_dma_desc	*tx_ring;
+	dma_addr_t		tx_phys;
+	struct sk_buff		*tx_skb[FE_NUM_TX];
+	dma_addr_t		tx_dma[FE_NUM_TX];
+	unsigned int		tx_next;	/* next free slot (sw) */
+	unsigned int		tx_free;	/* oldest in-flight slot */
+	spinlock_t		tx_lock;
+};
+
+static inline void fe_w32(struct fe_priv *p, u32 val, unsigned int reg)
+{
+	writel(val, p->base + reg);
+}
+
+static inline u32 fe_r32(struct fe_priv *p, unsigned int reg)
+{
+	return readl(p->base + reg);
+}
+
+static inline void esw_w32(struct fe_priv *p, u32 val, unsigned int reg)
+{
+	writel(val, p->esw + reg);
+}
+
+static inline u32 esw_r32(struct fe_priv *p, unsigned int reg)
+{
+	return readl(p->esw + reg);
+}
+
+static void esw_rmw(struct fe_priv *p, unsigned int reg, u32 mask, u32 val)
+{
+	esw_w32(p, (esw_r32(p, reg) & ~mask) | val, reg);
+}
+
+/* ------------------------------------------------------------------ */
+/* embedded switch                                                     */
+/* ------------------------------------------------------------------ */
+
+static int esw_mii_write(struct fe_priv *p, u32 phy, u32 reg, u32 val)
+{
+	unsigned long t;
+
+	t = jiffies + ESW_PHY_TIMEOUT;
+	while (esw_r32(p, ESW_REG_PCR1) & ESW_PCR1_WT_DONE) {
+		if (time_after(jiffies, t))
+			goto timeout;
+		cpu_relax();
+	}
+
+	esw_w32(p, ((val & 0xffff) << ESW_PCR0_WT_NWAY_DATA_S) |
+		   (reg << ESW_PCR0_CPU_PHY_REG_S) | phy | ESW_PCR0_WT_PHY_CMD,
+		ESW_REG_PCR0);
+
+	t = jiffies + ESW_PHY_TIMEOUT;
+	while (!(esw_r32(p, ESW_REG_PCR1) & ESW_PCR1_WT_DONE)) {
+		if (time_after(jiffies, t))
+			goto timeout;
+		cpu_relax();
+	}
+	return 0;
+
+timeout:
+	dev_err(p->dev, "switch MDIO timeout (phy %u reg %u)\n", phy, reg);
+	return -ETIMEDOUT;
+}
+
+static void esw_set_vlan(struct fe_priv *p, unsigned int idx, u32 vid, u32 ports)
+{
+	unsigned int s;
+
+	s = ESW_VLANI_VID_S * (idx % 2);
+	esw_rmw(p, ESW_REG_VLANI(idx / 2), ESW_VLANI_VID_M << s,
+		(vid & ESW_VLANI_VID_M) << s);
+	s = ESW_VMSC_MSC_S * (idx % 4);
+	esw_rmw(p, ESW_REG_VMSC(idx / 4), ESW_VMSC_MSC_M << s,
+		(ports & ESW_VMSC_MSC_M) << s);
+}
+
+static void esw_set_pvid(struct fe_priv *p, unsigned int port, u32 pvid)
+{
+	unsigned int s = ESW_PVIDC_PVID_S * (port % 2);
+
+	esw_rmw(p, ESW_REG_PVIDC(port / 2), ESW_PVIDC_PVID_M << s,
+		(pvid & ESW_PVIDC_PVID_M) << s);
+}
+
+static void esw_set_port_disable(struct fe_priv *p, u32 disable)
+{
+	u32 old, changed;
+	int i;
+
+	old = (esw_r32(p, ESW_REG_POC0) >> ESW_POC0_DIS_PORT_S) &
+	      ESW_POC0_DIS_PORT_M;
+	changed = old ^ disable;
+
+	/* enable before writing to MII */
+	esw_rmw(p, ESW_REG_POC0, ESW_POC0_DIS_PORT_M << ESW_POC0_DIS_PORT_S,
+		(old & disable) << ESW_POC0_DIS_PORT_S);
+
+	for (i = 0; i < ESW_NUM_PHYS; i++) {
+		if (!(changed & BIT(i)))
+			continue;
+		if (disable & BIT(i))
+			esw_mii_write(p, i, MII_BMCR, BMCR_PDOWN);
+		else
+			esw_mii_write(p, i, MII_BMCR, BMCR_FULLDPLX |
+				      BMCR_ANENABLE | BMCR_ANRESTART |
+				      BMCR_SPEED100);
+	}
+
+	esw_rmw(p, ESW_REG_POC0, ESW_POC0_DIS_PORT_M << ESW_POC0_DIS_PORT_S,
+		disable << ESW_POC0_DIS_PORT_S);
+}
+
+/*
+ * Two layouts are supported:
+ *  - flat (default): every port, CPU included, forwards to every other port
+ *    without VLAN tags, as done by the OpenWrt driver with VLANs disabled;
+ *  - LAN/WAN: VLAN 1 = LAN ports + CPU, VLAN 2 = WAN port + CPU. The CPU port
+ *    is tagged, so the host sees eth0.1 (LAN) and eth0.2 (WAN).
+ */
+static void esw_apply_vlans(struct fe_priv *p)
+{
+	u32 untag, en_vlan, doubletag;
+	int i;
+
+	for (i = 0; i < ESW_NUM_VLANS; i++)
+		esw_set_vlan(p, i, ESW_VLAN_NONE, 0);
+
+	if (p->wan_port < 0) {
+		for (i = 0; i < ESW_NUM_PORTS; i++)
+			esw_set_pvid(p, i, 0);
+		doubletag = ESW_PORTS_ALL;
+		en_vlan = ESW_PORTS_ALL;
+		untag = ESW_PORTS_ALL;
+		/* vlan 0 is special: no tag is prepended */
+		esw_set_vlan(p, 0, 0, ESW_PORTS_ALL);
+	} else {
+		u32 wan = BIT(p->wan_port);
+		u32 lan = ESW_PORTS_INTERNAL & ~wan;
+
+		esw_set_vlan(p, 0, 1, lan | ESW_PORTS_CPU);
+		esw_set_vlan(p, 1, 2, wan | ESW_PORTS_CPU);
+		for (i = 0; i < ESW_NUM_PORTS; i++)
+			esw_set_pvid(p, i, (BIT(i) & wan) ? 2 : 1);
+		doubletag = 0;
+		en_vlan = ESW_PORTS_ALL;
+		untag = ESW_PORTS_NOCPU;
+	}
+
+	esw_set_port_disable(p, p->port_disable);
+	esw_rmw(p, ESW_REG_SGC2, ESW_SGC2_DOUBLE_TAG_M << ESW_SGC2_DOUBLE_TAG_S,
+		doubletag << ESW_SGC2_DOUBLE_TAG_S);
+	esw_rmw(p, ESW_REG_PFC1, ESW_PFC1_EN_VLAN_M << ESW_PFC1_EN_VLAN_S,
+		en_vlan << ESW_PFC1_EN_VLAN_S);
+	esw_rmw(p, ESW_REG_POC2, ESW_POC2_UNTAG_EN_M << ESW_POC2_UNTAG_EN_S,
+		untag << ESW_POC2_UNTAG_EN_S);
+}
+
+static void esw_hw_init(struct fe_priv *p)
+{
+	u32 pmap;
+	int i;
+
+	/* values from the vendor driver, see esw_rt3050.c */
+	esw_w32(p, 0xc8a07850, ESW_REG_FCT0);
+	esw_w32(p, 0x00000000, ESW_REG_SGC2);
+	/* port priority 1 for all ports, vlan enabled */
+	esw_w32(p, 0x00005555 | (ESW_PORTS_ALL << ESW_PFC1_EN_VLAN_S),
+		ESW_REG_PFC1);
+	/* enable all ports, back pressure and flow control */
+	esw_w32(p, (ESW_PORTS_ALL << ESW_POC0_EN_BP_S) |
+		   (ESW_PORTS_ALL << ESW_POC0_EN_FC_S), ESW_REG_POC0);
+	/* enable aging and vlan tag removal */
+	esw_w32(p, (ESW_PORTS_ALL << ESW_POC2_ENAGING_S) |
+		   (ESW_PORTS_NOCPU << ESW_POC2_UNTAG_EN_S), ESW_REG_POC2);
+	esw_w32(p, 0x0002500c, ESW_REG_FCT2);
+	/* 300s aging, max frame 1536, no storm protection, 30ms led flash */
+	esw_w32(p, 0x0008a301, ESW_REG_SGC);
+	/* the CPU port receives unknown unicast/multicast/broadcast */
+	esw_w32(p, ESW_SOCPC_CRC_PADDING |
+		   (ESW_PORTS_CPU << ESW_SOCPC_DISUN2CPU_S) |
+		   (ESW_PORTS_CPU << ESW_SOCPC_DISMC2CPU_S) |
+		   (ESW_PORTS_CPU << ESW_SOCPC_DISBC2CPU_S), ESW_REG_SOCPC);
+	/* port 5 (external) disabled, port 6 (CPU) forced gige full duplex */
+	esw_w32(p, 0x3f502b28, ESW_REG_FPA2);
+	esw_w32(p, 0x00000000, ESW_REG_FPA);
+	/* link/activity on the port LEDs */
+	for (i = 0; i < ESW_NUM_PHYS; i++)
+		esw_w32(p, 0x00000005, ESW_REG_P0LED + 4 * i);
+
+	/* ports that stay disabled after enabling all of them don't exist */
+	p->port_disable |= (esw_r32(p, ESW_REG_POC0) >> ESW_POC0_DIS_PORT_S) &
+			   ESW_POC0_DIS_PORT_M;
+
+	/* RT3050/RT3052/RT3350 internal PHY setup ("else" branch upstream) */
+	esw_mii_write(p, 0, 31, 0x8000);
+	for (i = 0; i < ESW_NUM_PHYS; i++) {
+		if (p->port_disable & BIT(i))
+			esw_mii_write(p, i, MII_BMCR, BMCR_PDOWN);
+		else
+			esw_mii_write(p, i, MII_BMCR, BMCR_FULLDPLX |
+				      BMCR_ANENABLE | BMCR_SPEED100);
+		esw_mii_write(p, i, 26, 0x1601);	/* TX10 waveform */
+		esw_mii_write(p, i, 29, 0x7058);	/* TX AD/DA bias */
+		esw_mii_write(p, i, 30, 0x0018);	/* TX100 slew rate */
+	}
+	esw_mii_write(p, 0, 31, 0x0);		/* global registers */
+	esw_mii_write(p, 0, 22, 0x052f);	/* TP_IDL waveform */
+	esw_mii_write(p, 0, 17, 0x0fe0);	/* TX10 amplitude threshold */
+	esw_mii_write(p, 0, 18, 0x40ba);	/* squelch amplitude */
+	esw_mii_write(p, 0, 14, 0x0065);	/* TP_IDL tail length */
+	esw_mii_write(p, 0, 31, 0x8000);	/* local registers */
+
+	pmap = ESW_PMAP_LLLLLL;
+	if (p->wan_port >= 0)
+		pmap &= ~BIT(p->wan_port);
+	esw_rmw(p, ESW_REG_SGC2, ESW_SGC2_LAN_PMAP_M << ESW_SGC2_LAN_PMAP_S,
+		pmap << ESW_SGC2_LAN_PMAP_S);
+
+	esw_apply_vlans(p);
+
+	/* mask all switch interrupts, link state is polled from POA */
+	esw_w32(p, ~0, ESW_REG_IMR);
+	esw_w32(p, esw_r32(p, ESW_REG_ISR), ESW_REG_ISR);
+}
+
+/* ------------------------------------------------------------------ */
+/* frame engine                                                        */
+/* ------------------------------------------------------------------ */
+
+static void fe_set_mac(struct fe_priv *p, const u8 *mac)
+{
+	fe_w32(p, (mac[0] << 8) | mac[1], FE_GDMA1_MAC_ADRH);
+	fe_w32(p, (mac[2] << 24) | (mac[3] << 16) | (mac[4] << 8) | mac[5],
+	       FE_GDMA1_MAC_ADRL);
+}
+
+static void fe_hw_init(struct fe_priv *p)
+{
+	u32 v;
+
+	fe_w32(p, 0, FE_DLY_INT_CFG);
+	fe_w32(p, 0, FE_INT_ENABLE);
+	fe_w32(p, ~0, FE_INT_STATUS);
+
+	/* microsecond tick counter, needed by every RT305x except RT3052 */
+	if (p->sysclk) {
+		v = fe_r32(p, FE_GLO_CFG);
+		v &= ~(FE_US_CYC_CNT_MASK << FE_US_CYC_CNT_SHIFT);
+		v |= ((p->sysclk / 1000000) & FE_US_CYC_CNT_MASK) <<
+		     FE_US_CYC_CNT_SHIFT;
+		fe_w32(p, v, FE_GLO_CFG);
+	}
+
+	/*
+	 * GDMA1: forward unicast/multicast/broadcast/other frames to the CPU
+	 * (port 0), no jumbo frames, no rx checksum offload.
+	 */
+	v = fe_r32(p, FE_GDMA1_FWD_CFG);
+	v &= ~(0xffff | FE_GDM1_JMB_EN | FE_GDM1_ICS_EN | FE_GDM1_TCS_EN |
+	       FE_GDM1_UCS_EN);
+	fe_w32(p, v, FE_GDMA1_FWD_CFG);
+
+	/* no tx checksum generation */
+	fe_w32(p, fe_r32(p, FE_CDMA_CSG_CFG) &
+	       ~(FE_CSG_ICS_GEN_EN | FE_CSG_UCS_GEN_EN | FE_CSG_TCS_GEN_EN),
+	       FE_CDMA_CSG_CFG);
+
+	fe_w32(p, FE_PSE_FQFC_CFG_INIT, FE_PSE_FQ_CFG);
+}
+
+static void fe_free_rings(struct fe_priv *p)
+{
+	int i;
+
+	for (i = 0; i < FE_NUM_RX; i++) {
+		if (!p->rx_buf[i])
+			continue;
+		dma_unmap_single(p->dev, p->rx_dma[i], FE_RX_BUF_SIZE,
+				 DMA_FROM_DEVICE);
+		kfree(p->rx_buf[i]);
+		p->rx_buf[i] = NULL;
+	}
+	for (i = 0; i < FE_NUM_TX; i++) {
+		if (!p->tx_skb[i])
+			continue;
+		dma_unmap_single(p->dev, p->tx_dma[i], p->tx_skb[i]->len,
+				 DMA_TO_DEVICE);
+		dev_kfree_skb_any(p->tx_skb[i]);
+		p->tx_skb[i] = NULL;
+	}
+	if (p->rx_ring)
+		dma_free_coherent(p->dev, FE_NUM_RX * sizeof(*p->rx_ring),
+				  p->rx_ring, p->rx_phys);
+	if (p->tx_ring)
+		dma_free_coherent(p->dev, FE_NUM_TX * sizeof(*p->tx_ring),
+				  p->tx_ring, p->tx_phys);
+	p->rx_ring = NULL;
+	p->tx_ring = NULL;
+}
+
+static int fe_alloc_rings(struct fe_priv *p)
+{
+	int i;
+
+	p->tx_ring = dma_alloc_coherent(p->dev, FE_NUM_TX * sizeof(*p->tx_ring),
+					&p->tx_phys, GFP_KERNEL);
+	p->rx_ring = dma_alloc_coherent(p->dev, FE_NUM_RX * sizeof(*p->rx_ring),
+					&p->rx_phys, GFP_KERNEL);
+	if (!p->tx_ring || !p->rx_ring)
+		goto err;
+
+	for (i = 0; i < FE_NUM_TX; i++) {
+		p->tx_ring[i].d1 = 0;
+		p->tx_ring[i].d2 = TX_DMA_DESP2_DEF;
+		p->tx_ring[i].d3 = 0;
+		p->tx_ring[i].d4 = TX_DMA_DESP4_DEF;
+	}
+	p->tx_next = 0;
+	p->tx_free = 0;
+
+	for (i = 0; i < FE_NUM_RX; i++) {
+		p->rx_buf[i] = kmalloc(FE_RX_BUF_SIZE, GFP_KERNEL);
+		if (!p->rx_buf[i])
+			goto err;
+		p->rx_dma[i] = dma_map_single(p->dev, p->rx_buf[i],
+					      FE_RX_BUF_SIZE, DMA_FROM_DEVICE);
+		if (dma_mapping_error(p->dev, p->rx_dma[i])) {
+			kfree(p->rx_buf[i]);
+			p->rx_buf[i] = NULL;
+			goto err;
+		}
+		p->rx_ring[i].d1 = p->rx_dma[i];
+		p->rx_ring[i].d2 = RX_DMA_LSO;
+		p->rx_ring[i].d3 = 0;
+		p->rx_ring[i].d4 = 0;
+	}
+	p->rx_idx = FE_NUM_RX - 1;
+	wmb();
+
+	fe_w32(p, p->tx_phys, FE_TX_BASE_PTR0);
+	fe_w32(p, FE_NUM_TX, FE_TX_MAX_CNT0);
+	fe_w32(p, 0, FE_TX_CTX_IDX0);
+	fe_w32(p, PDMA_PST_DTX_IDX0, FE_PDMA_RST_CFG);
+
+	fe_w32(p, p->rx_phys, FE_RX_BASE_PTR0);
+	fe_w32(p, FE_NUM_RX, FE_RX_MAX_CNT0);
+	fe_w32(p, p->rx_idx, FE_RX_CALC_IDX0);
+	fe_w32(p, PDMA_PST_DRX_IDX0, FE_PDMA_RST_CFG);
+	return 0;
+
+err:
+	fe_free_rings(p);
+	return -ENOMEM;
+}
+
+static unsigned int fe_tx_avail(struct fe_priv *p)
+{
+	return FE_NUM_TX - 1 - ((p->tx_next - p->tx_free) % FE_NUM_TX);
+}
+
+static int fe_poll_tx(struct fe_priv *p)
+{
+	struct net_device *ndev = p->netdev;
+	unsigned int hw, done = 0, bytes = 0;
+
+	spin_lock(&p->tx_lock);
+	hw = fe_r32(p, FE_TX_DTX_IDX0) % FE_NUM_TX;
+	while (p->tx_free != hw) {
+		unsigned int i = p->tx_free;
+		struct sk_buff *skb = p->tx_skb[i];
+
+		if (skb) {
+			dma_unmap_single(p->dev, p->tx_dma[i], skb->len,
+					 DMA_TO_DEVICE);
+			bytes += skb->len;
+			done++;
+			napi_consume_skb(skb, 1);
+			p->tx_skb[i] = NULL;
+		}
+		p->tx_free = (i + 1) % FE_NUM_TX;
+	}
+	if (done) {
+		netdev_completed_queue(ndev, done, bytes);
+		if (netif_queue_stopped(ndev) && fe_tx_avail(p) > FE_NUM_TX / 4)
+			netif_wake_queue(ndev);
+	}
+	spin_unlock(&p->tx_lock);
+	return done;
+}
+
+static int fe_poll_rx(struct fe_priv *p, int budget)
+{
+	struct net_device *ndev = p->netdev;
+	int done = 0;
+
+	while (done < budget) {
+		unsigned int i = (p->rx_idx + 1) % FE_NUM_RX;
+		struct fe_dma_desc *d = &p->rx_ring[i];
+		struct sk_buff *skb;
+		u32 d2 = READ_ONCE(d->d2);
+		unsigned int len;
+
+		if (!(d2 & RX_DMA_DONE))
+			break;
+		dma_rmb();
+
+		len = RX_DMA_GET_PLEN0(d2);
+		if (unlikely(len < ETH_HLEN || len > FE_RX_BUF_SIZE)) {
+			ndev->stats.rx_length_errors++;
+			goto recycle;
+		}
+
+		skb = napi_alloc_skb(&p->napi, len);
+		if (unlikely(!skb)) {
+			ndev->stats.rx_dropped++;
+			goto recycle;
+		}
+		dma_sync_single_for_cpu(p->dev, p->rx_dma[i], len,
+					DMA_FROM_DEVICE);
+		skb_put_data(skb, p->rx_buf[i], len);
+		dma_sync_single_for_device(p->dev, p->rx_dma[i], len,
+					   DMA_FROM_DEVICE);
+
+		skb->protocol = eth_type_trans(skb, ndev);
+		ndev->stats.rx_packets++;
+		ndev->stats.rx_bytes += len;
+		napi_gro_receive(&p->napi, skb);
+
+recycle:
+		d->d2 = RX_DMA_LSO;
+		wmb();
+		p->rx_idx = i;
+		fe_w32(p, i, FE_RX_CALC_IDX0);
+		done++;
+	}
+	return done;
+}
+
+static int fe_poll(struct napi_struct *napi, int budget)
+{
+	struct fe_priv *p = container_of(napi, struct fe_priv, napi);
+	int rx;
+
+	/* ack first, so nothing arriving while we work is lost */
+	fe_w32(p, FE_INT_MASK, FE_INT_STATUS);
+
+	fe_poll_tx(p);
+	rx = fe_poll_rx(p, budget);
+
+	if (rx < budget && napi_complete_done(napi, rx))
+		fe_w32(p, FE_INT_MASK, FE_INT_ENABLE);
+
+	return rx;
+}
+
+static irqreturn_t fe_irq(int irq, void *data)
+{
+	struct fe_priv *p = data;
+	u32 status = fe_r32(p, FE_INT_STATUS) & fe_r32(p, FE_INT_ENABLE);
+
+	if (!status)
+		return IRQ_NONE;
+
+	fe_w32(p, 0, FE_INT_ENABLE);
+	napi_schedule(&p->napi);
+	return IRQ_HANDLED;
+}
+
+static netdev_tx_t fe_start_xmit(struct sk_buff *skb, struct net_device *ndev)
+{
+	struct fe_priv *p = netdev_priv(ndev);
+	struct fe_dma_desc *d;
+	dma_addr_t addr;
+	unsigned int i;
+
+	if (skb_linearize(skb)) {
+		dev_kfree_skb_any(skb);
+		ndev->stats.tx_dropped++;
+		return NETDEV_TX_OK;
+	}
+
+	/* RT305x padding bug: frames that get a vlan tag stripped by the
+	 * switch must still be 60 bytes afterwards, so pad to 64.
+	 */
+	if (skb_put_padto(skb, FE_TX_MIN_LEN)) {
+		ndev->stats.tx_dropped++;
+		return NETDEV_TX_OK;	/* skb already freed */
+	}
+
+	addr = dma_map_single(p->dev, skb->data, skb->len, DMA_TO_DEVICE);
+	if (dma_mapping_error(p->dev, addr)) {
+		dev_kfree_skb_any(skb);
+		ndev->stats.tx_dropped++;
+		return NETDEV_TX_OK;
+	}
+
+	spin_lock_bh(&p->tx_lock);
+	if (unlikely(!fe_tx_avail(p))) {
+		netif_stop_queue(ndev);
+		spin_unlock_bh(&p->tx_lock);
+		dma_unmap_single(p->dev, addr, skb->len, DMA_TO_DEVICE);
+		return NETDEV_TX_BUSY;
+	}
+
+	i = p->tx_next;
+	d = &p->tx_ring[i];
+	p->tx_skb[i] = skb;
+	p->tx_dma[i] = addr;
+	d->d1 = addr;
+	d->d3 = 0;
+	d->d4 = TX_DMA_DESP4_DEF;
+	wmb();
+	d->d2 = TX_DMA_PLEN0(skb->len) | TX_DMA_LS0;
+	wmb();
+
+	ndev->stats.tx_packets++;
+	ndev->stats.tx_bytes += skb->len;
+	netdev_sent_queue(ndev, skb->len);
+
+	p->tx_next = (i + 1) % FE_NUM_TX;
+	fe_w32(p, p->tx_next, FE_TX_CTX_IDX0);
+
+	if (!fe_tx_avail(p))
+		netif_stop_queue(ndev);
+	spin_unlock_bh(&p->tx_lock);
+
+	return NETDEV_TX_OK;
+}
+
+static int fe_open(struct net_device *ndev)
+{
+	struct fe_priv *p = netdev_priv(ndev);
+	int err;
+
+	err = fe_alloc_rings(p);
+	if (err)
+		return err;
+
+	netdev_reset_queue(ndev);
+	fe_w32(p, PDMA_TX_WB_DDONE | PDMA_RX_DMA_EN | PDMA_TX_DMA_EN |
+		  PDMA_SIZE_8DWORDS, FE_PDMA_GLO_CFG);
+
+	napi_enable(&p->napi);
+	fe_w32(p, FE_INT_MASK, FE_INT_STATUS);
+	fe_w32(p, FE_INT_MASK, FE_INT_ENABLE);
+	netif_carrier_on(ndev);
+	netif_start_queue(ndev);
+	return 0;
+}
+
+static int fe_stop(struct net_device *ndev)
+{
+	struct fe_priv *p = netdev_priv(ndev);
+	int i;
+
+	netif_tx_disable(ndev);
+	netif_carrier_off(ndev);
+	fe_w32(p, 0, FE_INT_ENABLE);
+	napi_disable(&p->napi);
+
+	fe_w32(p, fe_r32(p, FE_PDMA_GLO_CFG) &
+	       ~(PDMA_TX_WB_DDONE | PDMA_RX_DMA_EN | PDMA_TX_DMA_EN),
+	       FE_PDMA_GLO_CFG);
+	for (i = 0; i < 10; i++) {
+		if (!(fe_r32(p, FE_PDMA_GLO_CFG) &
+		      (PDMA_TX_DMA_BUSY | PDMA_RX_DMA_BUSY)))
+			break;
+		msleep(20);
+	}
+
+	fe_free_rings(p);
+	return 0;
+}
+
+static int fe_set_mac_address(struct net_device *ndev, void *addr)
+{
+	struct fe_priv *p = netdev_priv(ndev);
+	int err = eth_mac_addr(ndev, addr);
+
+	if (!err)
+		fe_set_mac(p, ndev->dev_addr);
+	return err;
+}
+
+static const struct net_device_ops fe_netdev_ops = {
+	.ndo_open		= fe_open,
+	.ndo_stop		= fe_stop,
+	.ndo_start_xmit		= fe_start_xmit,
+	.ndo_set_mac_address	= fe_set_mac_address,
+	.ndo_validate_addr	= eth_validate_addr,
+};
+
+static int fe_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np = dev->of_node;
+	struct device_node *esw_np;
+	struct net_device *ndev;
+	struct fe_priv *p;
+	struct clk *clk;
+	u32 val;
+	int err;
+
+	ndev = devm_alloc_etherdev(dev, sizeof(*p));
+	if (!ndev)
+		return -ENOMEM;
+	SET_NETDEV_DEV(ndev, dev);
+
+	p = netdev_priv(ndev);
+	p->netdev = ndev;
+	p->dev = dev;
+	p->wan_port = -1;
+	spin_lock_init(&p->tx_lock);
+
+	p->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(p->base))
+		return PTR_ERR(p->base);
+
+	esw_np = of_parse_phandle(np, "ralink,switch", 0);
+	if (!esw_np)
+		return dev_err_probe(dev, -EINVAL, "no ralink,switch phandle\n");
+	p->esw = devm_of_iomap(dev, esw_np, 0, NULL);
+	if (!of_property_read_u32(esw_np, "ralink,wan-port", &val) &&
+	    val < ESW_NUM_PHYS)
+		p->wan_port = val;
+	if (!of_property_read_u32(esw_np, "ralink,port-disable", &val))
+		p->port_disable = val & ESW_POC0_DIS_PORT_M;
+	of_node_put(esw_np);
+	if (IS_ERR(p->esw))
+		return PTR_ERR(p->esw);
+
+	p->irq = platform_get_irq(pdev, 0);
+	if (p->irq < 0)
+		return p->irq;
+
+	clk = devm_clk_get_optional(dev, NULL);
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+	p->sysclk = clk_get_rate(clk);
+	if (!p->sysclk)
+		dev_warn(dev, "no bus clock, microsecond counter not set\n");
+
+	p->rst_fe = devm_reset_control_get_optional_exclusive(dev, "fe");
+	if (IS_ERR(p->rst_fe))
+		return PTR_ERR(p->rst_fe);
+	reset_control_assert(p->rst_fe);
+	usleep_range(10, 20);
+	reset_control_deassert(p->rst_fe);
+	usleep_range(10, 20);
+
+	err = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (err)
+		return err;
+
+	err = of_get_ethdev_address(np, ndev);
+	if (err == -EPROBE_DEFER)
+		return err;
+	if (err) {
+		eth_hw_addr_random(ndev);
+		dev_warn(dev, "using random MAC %pM\n", ndev->dev_addr);
+	}
+
+	fe_hw_init(p);
+	fe_set_mac(p, ndev->dev_addr);
+	esw_hw_init(p);
+
+	ndev->netdev_ops = &fe_netdev_ops;
+	ndev->irq = p->irq;
+	ndev->watchdog_timeo = 5 * HZ;
+	ndev->min_mtu = ETH_MIN_MTU;
+	ndev->max_mtu = FE_RX_BUF_SIZE - VLAN_ETH_HLEN - ETH_FCS_LEN;
+	netif_napi_add(ndev, &p->napi, fe_poll);
+
+	err = devm_request_irq(dev, p->irq, fe_irq, 0, dev_name(dev), p);
+	if (err)
+		return err;
+
+	err = register_netdev(ndev);
+	if (err)
+		return err;
+
+	platform_set_drvdata(pdev, ndev);
+	netdev_info(ndev, "RT305x frame engine at irq %d, MAC %pM, switch %s, ports 0x%02x present\n",
+		    p->irq, ndev->dev_addr,
+		    p->wan_port < 0 ? "flat" : "LAN/WAN vlans",
+		    (u32)(~p->port_disable & ESW_PORTS_NOCPU));
+	return 0;
+}
+
+static void fe_remove(struct platform_device *pdev)
+{
+	struct net_device *ndev = platform_get_drvdata(pdev);
+	struct fe_priv *p = netdev_priv(ndev);
+
+	unregister_netdev(ndev);
+	netif_napi_del(&p->napi);
+}
+
+static const struct of_device_id fe_of_match[] = {
+	{ .compatible = "ralink,rt3050-eth" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, fe_of_match);
+
+static struct platform_driver fe_driver = {
+	.probe	= fe_probe,
+	.remove	= fe_remove,
+	.driver	= {
+		.name		= DRV_NAME,
+		.of_match_table	= fe_of_match,
+	},
+};
+module_platform_driver(fe_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Ralink RT305x frame engine and switch driver");

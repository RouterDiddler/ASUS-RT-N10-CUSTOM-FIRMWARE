diff --git a/arch/mips/boot/dts/ralink/rt3350_asus_rt-n10-b1.dts b/arch/mips/boot/dts/ralink/rt3350_asus_rt-n10-b1.dts
new file mode 100644
index 000000000..b3263fc2d
--- /dev/null
+++ b/arch/mips/boot/dts/ralink/rt3350_asus_rt-n10-b1.dts
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: GPL-2.0
+/dts-v1/;
+
+#include "rt3050.dtsi"
+
+/ {
+	compatible = "asus,rt-n10-b1", "ralink,rt3350-soc";
+	model = "ASUS RT-N10 B1";
+
+	chosen {
+		bootargs = "console=ttyS0,57600 panic=5 root=/dev/mtdblock4 rootfstype=squashfs ro";
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+	};
+
+	/* 4 MiB MX29LV320 parallel NOR, 16 bit */
+	flash@1f000000 {
+		compatible = "cfi-flash";
+		reg = <0x1f000000 0x400000>;
+		bank-width = <2>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "u-boot";
+				reg = <0x0 0x30000>;
+				read-only;
+			};
+
+			partition@30000 {
+				label = "nvram";
+				reg = <0x30000 0x10000>;
+				read-only;
+			};
+
+			/* wifi calibration (RT3050 EEPROM layout) and MAC */
+			partition@40000 {
+				compatible = "nvmem-cells";
+				label = "factory";
+				reg = <0x40000 0x10000>;
+				read-only;
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				eeprom_factory_0: eeprom@0 {
+					reg = <0x0 0x200>;
+				};
+
+				macaddr_factory_4: macaddr@4 {
+					reg = <0x4 0x6>;
+				};
+			};
+
+			/* U-Boot boots the uImage at 0xbfc50000 */
+			partition@50000 {
+				label = "kernel";
+				reg = <0x50000 0x220000>;
+				read-only;
+			};
+
+			/* squashfs (xz), root=/dev/mtdblock4 */
+			partition@270000 {
+				label = "rootfs";
+				reg = <0x270000 0x140000>;
+				read-only;
+			};
+
+			/*
+			 * JFFS2 for settings (/data). Read-only here so that the
+			 * RAM test image can never write to flash; post-image.sh
+			 * drops the flag for the flash kernel only.
+			 */
+			partition@3b0000 {
+				label = "data";
+				reg = <0x3b0000 0x50000>;
+				read-only; /* rtn10-data-ro */
+			};
+		};
+	};
+};
+
+&{/cpus/cpu@0} {
+	reg = <0>;
+};
+
+&{/palmbus@10000000} {
+	ethernet@100000 {
+		compatible = "ralink,rt3050-eth";
+		reg = <0x100000 0x10000>;
+
+		interrupt-parent = <&cpuintc>;
+		interrupts = <5>;
+
+		clocks = <&sysc RT305X_CLK_ETHERNET>;
+
+		resets = <&sysc 21>;
+		reset-names = "fe";
+
+		ralink,switch = <&esw>;
+
+		nvmem-cells = <&macaddr_factory_4>;
+		nvmem-cell-names = "mac-address";
+	};
+
+	esw: esw@110000 {
+		compatible = "ralink,rt3050-esw";
+		reg = <0x110000 0x8000>;
+
+		/* port 0 is WAN, ports 1-4 are LAN: eth0.1 = LAN, eth0.2 = WAN */
+		ralink,wan-port = <0>;
+	};
+
+	wmac@180000 {
+		compatible = "ralink,rt2880-wifi";
+		reg = <0x180000 0x40000>;
+
+		interrupt-parent = <&cpuintc>;
+		interrupts = <6>;
+
+		clocks = <&sysc RT305X_CLK_WMAC>;
+
+		nvmem-cells = <&eeprom_factory_0>;
+		nvmem-cell-names = "eeprom";
+	};
+};

 drivers/net/ethernet/Makefile                 |   1 +
 drivers/net/ethernet/ralink/Kconfig           |  20 +
 drivers/net/ethernet/ralink/Makefile          |   1 +
 drivers/net/ethernet/ralink/rt3050_eth.c      | 909 ++++++++++++++++++
 8 files changed, 1069 insertions(+)
 create mode 100644 arch/mips/boot/dts/ralink/rt3350_asus_rt-n10-b1.dts

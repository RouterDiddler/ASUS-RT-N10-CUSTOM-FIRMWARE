From 8657bffd24267ac067947cab063939ce76cd1e66 Mon Sep 17 00:00:00 2001
From: RT-N10 build <rtn10@localhost>
Date: Sat, 14 Nov 2026 20:53:46 +0300
Subject: [PATCH] MIPS: dts: ralink: RT-N10 B1: mark kernel/rootfs read-only
 flags for the flash build

---
 arch/mips/boot/dts/ralink/rt3350_asus_rt-n10-b1.dts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/mips/boot/dts/ralink/rt3350_asus_rt-n10-b1.dts b/arch/mips/boot/dts/ralink/rt3350_asus_rt-n10-b1.dts
index ff28fa2cf..879154524 100644
--- a/arch/mips/boot/dts/ralink/rt3350_asus_rt-n10-b1.dts
+++ b/arch/mips/boot/dts/ralink/rt3350_asus_rt-n10-b1.dts
@@ -61,14 +61,14 @@ macaddr_factory_4: macaddr@4 {
 			partition@50000 {
 				label = "kernel";
 				reg = <0x50000 0x1f0000>;
-				read-only;
+				read-only; /* rtn10-fw-ro */
 			};
 
 			/* squashfs (xz), root=/dev/mtdblock4 */
 			partition@240000 {
 				label = "rootfs";
 				reg = <0x240000 0x170000>;
-				read-only;
+				read-only; /* rtn10-fw-ro */
 			};
 
 			/*
-- 
2.56.1

